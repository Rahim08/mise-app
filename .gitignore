# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.bak

# internal notes (never commit — architecture/ops/diagnostic details)
CLAUDE CONTEXT.md
CLAUDE_CONTEXT.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets / private keys (APNs .p8, etc.) — НИКОГДА не коммитить
*.p8
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
mise-app/

# Xcode build artifacts
native/Mise/build/
CLAUDE CONTEXT.md

# Xcode user-specific IDE state (workspace UI, breakpoints — not project config)
native/Mise/**/xcuserdata/
