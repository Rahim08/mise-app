# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_resend_api_key

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_your_starter_price_id
STRIPE_PRICE_BUSINESS=price_your_business_price_id
STRIPE_PRICE_PRO=price_your_pro_price_id

# AI (Groq)
GROQ_API_KEY=gsk_your_groq_api_key

# Auth
MISE_TOKEN_SECRET=your_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=https://misesuite.com
NODE_ENV=production

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Email
MISE_EMAIL_FROM=Mise <noreply@yourdomain.com>

# Cron / Health
CRON_SECRET=your_cron_secret
HEALTH_CHECK_SECRET=your_health_check_secret

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# APNs (Apple Push Notifications)
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_TOPIC=com.mise.app
APNS_AUTH_KEY=/path/to/AuthKey.p8
APNS_PRODUCTION=true
